# Nexora PRODUCTION environment - TEMPLATE ONLY.
#
# The real file lives on the production host at
# /etc/nexora/env/production.env, owned by root, mode 600. It is deliberately
# OUTSIDE every developer worktree, so that no `docker compose` invocation run
# from a checkout can pick up production credentials by accident, and no
# `git add` can ever reach it.
#
# Nothing in this template is a real value, and no real value may ever be
# written into a file inside the repository.
#
#   Generate each secret independently:  openssl rand -hex 48
#
# ---------------------------------------------------------------------------
# CURRENT STATE - READ BEFORE PROVISIONING (audit finding P0-4)
# ---------------------------------------------------------------------------
# The running customer stack does not define POSTGRES_PASSWORD or JWT_SECRET
# at all, so compose.yaml's built-in fallbacks apply and production is
# currently running on the literal development defaults
# ("nexora-local-password" and "change-this-local-jwt-secret") that are
# committed to this repository and shared with every developer's machine.
#
# Provisioning this file with real generated values is therefore not just
# environment hygiene - it is the fix for that finding. Changing JWT_SECRET
# invalidates existing sessions and changing POSTGRES_PASSWORD requires an
# ALTER ROLE on the live database, so both belong in a planned maintenance
# window with a backup taken first, not in this stage.
# ---------------------------------------------------------------------------

NEXORA_ENV=production

POSTGRES_DB=nexora_prod
POSTGRES_USER=nexora_prod
POSTGRES_PASSWORD=<generate-unique-production-value>
DATABASE_URL=postgresql://nexora_prod:<generate-unique-production-value>@postgres:5432/nexora_prod

JWT_SECRET=<generate-unique-production-value>
ENROLLMENT_SECRET=<generate-unique-production-value>
ADMIN_API_TOKEN=<generate-unique-production-value>

API_BASE_URL=https://nexora.design.local/api
CORS_ALLOWED_ORIGINS=https://nexora.design.local

# Approved, immutable, reviewed image tags. Production never builds; these
# must already exist on the host and must carry org.nexora.* release labels
# (see scripts/env/build-release.sh).
NEXORA_IMAGE_API=<nexora-api:release-tag>
NEXORA_IMAGE_WEB=<nexora-web:release-tag>
NEXORA_IMAGE_MIGRATE=<nexora-migrate:release-tag>
NEXORA_RELEASE=<approved-release-name>

ONLINE_THRESHOLD_SECONDS=90
OFFLINE_THRESHOLD_SECONDS=120

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=<production-only-secret>
TELEGRAM_CHAT_ID=<production-only-chat-id>
EMAIL_ENABLED=false
SMTP_HOST=<production-smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=<production-only-username>
SMTP_PASSWORD=<production-only-secret>
SMTP_FROM=<production-from-address>
SMTP_TO=<production-operations-address>
WEBHOOK_ENABLED=false
WEBHOOK_URL=<production-only-webhook>
WEBHOOK_SIGNING_SECRET=<production-only-secret>
NOTIFY_ACKNOWLEDGED=false

# Remote command execution is not part of RC1 and stays disabled.
# compose.prod.yaml hard-codes this to "false" regardless of what is set here.
REMOTE_COMMANDS_ENABLED=false
