[Unit]
Description=Nexora external edge watcher (SEPARATE HOST ONLY)
OnFailure=nexora-platform-notify.service

[Service]
Type=oneshot
User=nexora-watch
Group=nexora-watch
WorkingDirectory=/opt/nexora-monitor
EnvironmentFile=/etc/nexora-monitor/edge.conf
Environment=NEXORA_WATCH_STATE_DIR=/var/lib/nexora-edge-watch
StateDirectory=nexora-edge-watch
ExecStart=/bin/bash /opt/nexora-monitor/edge-watch.sh
TimeoutStartSec=45
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/etc/nexora
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=all
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @raw-io @obsolete @privileged @resources
StandardOutput=journal
StandardError=journal
UMask=0077

