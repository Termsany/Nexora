[Unit]
Description=Nexora aggregate-only platform health
OnFailure=nexora-platform-notify.service

[Service]
Type=oneshot
User=nexora-monitor
Group=nexora-monitor
WorkingDirectory=/opt/nexora-monitor
EnvironmentFile=/etc/nexora-monitor/monitor.conf
LoadCredential=pgpass:/etc/nexora-monitor/credentials/pgpass
Environment=NEXORA_MON_STATE_DIR=/var/lib/nexora-monitor
StateDirectory=nexora-monitor
ExecStart=/bin/bash /opt/nexora-monitor/platform-health.sh --json-only
TimeoutStartSec=90
InaccessiblePaths=-/run/docker.sock -/var/run/docker.sock -/run/containerd -/var/lib/docker -/etc/nexora
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectProc=invisible
ProcSubset=all
RestrictNamespaces=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=~@mount @reboot @swap @raw-io @obsolete @privileged @resources
StandardOutput=journal
StandardError=journal
UMask=0077
