+import assert from 'node:assert/strict';
+import { readFileSync } from 'node:fs';
+import test from 'node:test';
+import vm from 'node:vm';
+import ts from 'typescript';
+
+const source = readFileSync(new URL('./remote-console.tsx', import.meta.url), 'utf8');
+const ast = ts.createSourceFile('console.tsx', source, ts.ScriptTarget.Latest, true, ts.ScriptKind.TSX);
+let paint;
+function visit(node) {
+  if (ts.isVariableDeclaration(node) && node.name.getText(ast) === 'paint') paint = node.initializer.arguments[0];
+  ts.forEachChild(node, visit);
+}
+visit(ast);
+assert.ok(paint);
+function setup() {
+  let resolve, drawn = 0, closed = 0;
+  const bitmap = { width: 100, height: 100, close() { closed++; } };
+  const canvasRef = { current: { width: 100, height: 100, getContext: () => ({ drawImage() { drawn++; } }) } };
+  const js = ts.transpileModule(`const fn = ${paint.getText(ast)}; fn;`, { compilerOptions: { target: ts.ScriptTarget.ES2022 } }).outputText;
+  const fn = vm.runInNewContext(js, { canvasRef, Blob, createImageBitmap: () => new Promise(r => { resolve = r; }) });
+  return { fn, canvasRef, finish: () => resolve(bitmap), drawn: () => drawn, closed: () => closed };
+}
+test('frame from a disconnected socket cannot paint after decode completes', async () => {
+  const h = setup(); let current = true;
+  const done = h.fn(new ArrayBuffer(10), () => current);
+  current = false; h.finish(); await done;
+  assert.equal(h.drawn(), 0); assert.equal(h.closed(), 1);
+});
+test('a replaced canvas cannot receive a stale decode', async () => {
+  const h = setup(); const done = h.fn(new ArrayBuffer(10), () => true);
+  h.canvasRef.current = null; h.finish(); await done;
+  assert.equal(h.drawn(), 0); assert.equal(h.closed(), 1);
+});
