# Nexora LOCAL DEVELOPMENT environment.
#
#   cp .env.development.example .env.development && chmod 600 .env.development
#
# Every value in this file is deliberately a fixed, well-known test value.
# That is the point: if a development secret is guessable, it can never be
# confused for a real one, and nothing real can ever be protected by it.
#
# Rules:
#   - Never copy a value from production or staging into this file.
#   - Never copy a value from this file anywhere else.
#   - .env.development is git-ignored and is safe to delete and recreate.

NEXORA_ENV=development

# Matches compose.dev.yaml. The dev database is disposable - `nexora-compose.sh
# development down -v` is always a safe thing to do.
POSTGRES_DB=nexora_dev
POSTGRES_USER=nexora_dev
POSTGRES_PASSWORD=dev-disposable-not-a-secret
DATABASE_URL=postgresql://nexora_dev:dev-disposable-not-a-secret@127.0.0.1:55430/nexora_dev

JWT_SECRET=dev-only-jwt-secret-not-for-any-real-environment
ENROLLMENT_SECRET=dev-only-enrollment-secret-not-for-any-real-environment
ADMIN_API_TOKEN=dev-only-admin-token-not-for-any-real-environment

API_BASE_URL=http://localhost:8080/api
CORS_ALLOWED_ORIGINS=http://localhost:8080

NEXORA_DEV_HTTP_PORT=8080
NEXORA_DEV_HTTPS_PORT=8443
NEXORA_DEV_API_PORT=3011
NEXORA_DEV_PG_PORT=55430

ONLINE_THRESHOLD_SECONDS=90
OFFLINE_THRESHOLD_SECONDS=120

# A developer machine must not be able to page anyone or call a webhook.
TELEGRAM_ENABLED=false
EMAIL_ENABLED=false
WEBHOOK_ENABLED=false
NOTIFY_ACKNOWLEDGED=false

# Remote command execution stays disabled.
REMOTE_COMMANDS_ENABLED=false
