# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# compiled output
dist
tmp
out-tsc
*.tsbuildinfo
.expo
.expo-shared

# dependencies
node_modules

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.cursor/rules/nx-rules.mdc
.github/instructions/nx.instructions.md

# Replit
.cache/
.local/
node_modules/

# Environment secrets. Only the *.example templates are ever tracked; every
# real environment file (including the legacy root .env) stays local, and
# production/staging secrets live on their hosts at /etc/nexora/env/, outside
# any worktree. See docs/environment-isolation.md.
.env
.env.*
!.env.example
!.env.development.example
!.env.staging.example
!.env.production.example

# Deployment-time build/publish artifacts (not source) - keep pilot/certificates/ tracked
/publish/
/pilot/windows-agent/

# Generated Windows Agent download package - built by scripts/build-windows-agent-package.sh,
# regenerated on demand, not committed (67+ MB binary; see docs/deployment.md)
/pilot/downloads/

# Database dumps contain customer data and must never enter git.
# NOTE: backups/nexora-pre-task009-20260830T222639Z.dump is ALREADY TRACKED
# (audit finding P0-5) - this rule prevents new ones, but removing the
# existing one requires a commit, and purging it from history requires a
# rewrite. Both are deliberately left for an explicitly approved change.
/backups/
*.dump
*.sql.gz

# PKI material must never enter git - CA/server keys live at /etc/nexora/pki/ on the host
*.key
*.pem

# Local package/build artifacts
.pnpm-store/
agent/**/bin/
agent/**/obj/

# Backup tooling (PR-04A): encrypted dumps, checksums, status/state files,
# the local test GPG keyring, and off-host simulation output are all
# disposable/local-only and must never enter git. See docs/backup-restore.md.
/backups/
*.dump.gpg
*.dump.sha256
backup-status.json
backup-state.json

# Python bytecode is generated at runtime by the monitoring/backup helpers and
# must never be tracked or deployed.
__pycache__/
*.pyc
