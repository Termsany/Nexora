APP_ENV=production

DATABASE_URL=postgresql://nexora:CHANGE_THIS_PASSWORD@postgres:5432/nexora

JWT_SECRET=VERY_LONG_RANDOM_SECRET

ENROLLMENT_SECRET=VERY_LONG_RANDOM_SECRET

API_BASE_URL=https://nexora.design.local/api

CORS_ALLOWED_ORIGINS=https://nexora.design.local

ADMIN_API_TOKEN=VERY_LONG_RANDOM_ADMIN_SECRET

ONLINE_THRESHOLD_SECONDS=90
OFFLINE_THRESHOLD_SECONDS=120

# Notification channels are disabled until both enabled and configured.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=<secret>
TELEGRAM_CHAT_ID=<chat-id>

EMAIL_ENABLED=false
SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=<username>
SMTP_PASSWORD=<secret>
SMTP_FROM=nexora@example.com
SMTP_TO=operations@example.com

WEBHOOK_ENABLED=false
WEBHOOK_URL=https://example.com/nexora/events
WEBHOOK_SIGNING_SECRET=<secret>

NOTIFY_ACKNOWLEDGED=false

# Remote command execution is disabled by default.
REMOTE_COMMANDS_ENABLED=false
