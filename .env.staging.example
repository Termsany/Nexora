# Nexora STAGING environment - TEMPLATE ONLY.
#
# The real file lives on the staging host at /etc/nexora/env/staging.env,
# owned by root, mode 600, and is never present in a developer worktree and
# never in git. Placeholders below are intentionally not valid values so this
# template cannot be used as-is.
#
#   Generate each secret independently:  openssl rand -hex 48
#
# Staging secrets must be generated fresh. Reusing a production secret in
# staging makes staging a production credential store, which defeats the
# entire point of having a separate environment to break things in.

NEXORA_ENV=staging

POSTGRES_DB=nexora_staging
POSTGRES_USER=nexora_staging
POSTGRES_PASSWORD=<generate-unique-staging-value>
DATABASE_URL=postgresql://nexora_staging:<generate-unique-staging-value>@postgres:5432/nexora_staging

JWT_SECRET=<generate-unique-staging-value>
ENROLLMENT_SECRET=<generate-unique-staging-value>
ADMIN_API_TOKEN=<generate-unique-staging-value>

API_BASE_URL=https://nexora-staging.design.local/api
CORS_ALLOWED_ORIGINS=https://nexora-staging.design.local

# Dedicated staging VM: same ports production uses. The old 8081/8444
# offsets were a shared-host workaround and are no longer supported.
NEXORA_HTTP_PORT=80
NEXORA_HTTPS_PORT=443

# Immutable release-candidate image tags. Staging validates exactly the images
# production will later run - never a rebuild from a worktree.
NEXORA_IMAGE_API=<nexora-api:RC-tag>
NEXORA_IMAGE_WEB=<nexora-web:RC-tag>
NEXORA_IMAGE_MIGRATE=<nexora-migrate:RC-tag>
NEXORA_RELEASE=<release-name>

ONLINE_THRESHOLD_SECONDS=90
OFFLINE_THRESHOLD_SECONDS=120

# Staging may exercise notification delivery, but only against staging-only
# destinations (a staging Telegram chat, a staging mailbox, a test webhook).
# Never a customer-facing destination.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=<staging-only-secret>
TELEGRAM_CHAT_ID=<staging-only-chat-id>
EMAIL_ENABLED=false
SMTP_HOST=<staging-smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=<staging-only-username>
SMTP_PASSWORD=<staging-only-secret>
SMTP_FROM=nexora-staging@example.invalid
SMTP_TO=staging-operations@example.invalid
WEBHOOK_ENABLED=false
WEBHOOK_URL=<staging-only-webhook>
WEBHOOK_SIGNING_SECRET=<staging-only-secret>
NOTIFY_ACKNOWLEDGED=false

REMOTE_COMMANDS_ENABLED=false
